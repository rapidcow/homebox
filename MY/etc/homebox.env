# This is ripped straight out of Dockerfile...
HBOX_MODE=production
HBOX_WEB_HOST=unix?path=/run/homebox/homebox.sock&mode=600
# This is an example S3/B2 url (needs to be accompanied
# by AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, and
# (optionally) AWS_SESSION_TOKEN).  See also Docs:
# https://homebox.software/en/configure/storage.html
#HBOX_STORAGE_CONN_STRING=s3://my-bucket?awssdk=v2&endpoint=https://s3.us-west-004.backblazeb2.com&disableSSL=false&s3ForcePathStyle=true
#AWS_ACCESS_KEY_ID=0080facebaeb600000001f
#AWS_SECRET_ACCESS_KEY=K0009/1guXjbIrdcPkG4itHezbA312
HBOX_STORAGE_CONN_STRING=file:///?no_tmp_dir=true
HBOX_STORAGE_PREFIX_PATH=data
HBOX_DATABASE_SQLITE_PATH=/usr/local/var/homebox/homebox.db?_pragma=busy_timeout=2000&_pragma=journal_mode=WAL&_fk=1&_time_format=sqlite
# True by default. I will make it false for now...
#HBOX_OPTIONS_ALLOW_REGISTRATION=true
